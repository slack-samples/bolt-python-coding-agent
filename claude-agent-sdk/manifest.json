{
  "display_information": {
    "name": "Coding Agent - Claude SDK"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Coding Agent - Claude SDK (Python)",
      "always_online": true
    },
    "agent_view": {
      "agent_description": "A coding agent that spins up a dedicated code channel to work on your task.",
      "suggested_prompts": [
        {
          "title": "Start a coding task",
          "message": "Fix a bug in a repository for me. I'll share the repo URL and what's wrong."
        },
        {
          "title": "Plan a change",
          "message": "Help me plan a change to a repository before any code is written."
        },
        {
          "title": "What can you do?",
          "message": "What can you do, and how do code channels work?"
        }
      ]
    },
    "code_channels": {
      "enabled": true,
      "slash_command_url": "https://ngrok-free.app/slack/events"
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://ngrok-free.app/slack/oauth_redirect"],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "canvases:write",
        "channels:history",
        "channels:read",
        "chat:write",
        "code_channels:manage",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://ngrok-free.app/slack/events",
      "bot_events": [
        "agent_session_stopped",
        "app_home_opened",
        "app_mention",
        "channel_archive",
        "group_archive",
        "message.channels",
        "message.groups",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://ngrok-free.app/slack/events"
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
